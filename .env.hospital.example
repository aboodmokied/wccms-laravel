# WCCMS on the hospital Oracle 11g database.
# Copy to .env, fill every <...>, then: php artisan key:generate && php artisan config:clear && php artisan wccms:check-hospital
# Never run php artisan migrate or db:seed against this database: the tables come from wccms_oracle_install.sql.

APP_NAME=WCCMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=<http://address-of-this-server>

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Oracle connection: the SAME account wccms_oracle_install.sql was run with (the clinic tables and procedures are in it)
DB_CONNECTION=oracle
DB_HOST=<oracle server>
DB_PORT=1521
DB_SERVICE_NAME=<service name>
DB_DATABASE=
DB_USERNAME=<the account that ran wccms_oracle_install.sql>
DB_PASSWORD=<its password>
DB_CHARSET=AL32UTF8
DB_SERVER_VERSION=11g
ORA_MAX_NAME_LEN=30

# No Laravel tables in Oracle: sessions, cache and queue stay on files / in process.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Hospital tables (schema HOS). php artisan wccms:check-hospital says what to change here.
HOSPITAL_NO=1
HOSPITAL_SCHEMA=HOS
HOSPITAL_FOREIGN_KEYS=false
HOSPITAL_DOCTOR_JOB_CODES=2
HOSPITAL_NURSE_JOB_CODES=
HOSPITAL_EMP_REC_CD=1
HOSPITAL_EMP_REC_CD_LISTS=all
HOSPITAL_EMP_ACTIVE=
HOSPITAL_NURSE_USER_TYPE=3
HOSPITAL_SEX_MALE_NAME_EN=Male
HOSPITAL_SEX_FEMALE_NAME_EN=Female

# No sign-in in WCCMS: whoever the hospital lets reach this server opens the system directly. Restrict access
# at the hospital side (internal network, firewall or the hospital portal), never expose this server publicly.
